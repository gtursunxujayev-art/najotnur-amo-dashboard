// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model TelegramUser {
  id            Int      @id @default(autoincrement())
  chatId        BigInt   @unique
  username      String?
  firstName     String?
  lastName      String?
  dailyReport   Boolean  @default(false)
  weeklyReport  Boolean  @default(false)
  monthlyReport Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CallsCache {
  id        Int      @id @default(autoincrement())
  period    String   @unique // e.g., "all" or "90days"
  data      String   // JSON-encoded calls data
  updatedAt DateTime @updatedAt
}

model OnlinePBXCall {
  id        String   @id @default(cuid())
  callId    String   @unique // Original call ID from OnlinePBX
  direction String   // "in" or "out"
  date      DateTime // When the call occurred
  duration  Int      // Duration in seconds
  phone     String   // Phone number
  user      String   // Manager/user name
  source    String   @default("webhook") // "webhook" or "api"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([user])
  @@index([createdAt])
}

model GoogleSheetCall {
  id              String   @id @default(cuid())
  callType        String   // "Пропущенный" / "Входящий" / "Исходящий" (Missed/Incoming/Outgoing)
  direction       String   // "missed" / "in" / "out"
  caller          String   // Caller ID/extension
  receiver        String   // Call receiver
  insideNumber    String?  // Inside number/gateway
  date            DateTime // When the call occurred
  duration        Int      // Call length in seconds
  successDuration Int      // Successful call length in seconds
  source          String   @default("sheet") // Source identifier
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date])
  @@index([caller])
  @@index([receiver])
  @@index([createdAt])
}
