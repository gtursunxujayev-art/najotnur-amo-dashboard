// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model TelegramUser {
  id            Int      @id @default(autoincrement())
  chatId        BigInt   @unique
  username      String?
  firstName     String?
  lastName      String?
  dailyReport   Boolean  @default(false)
  weeklyReport  Boolean  @default(false)
  monthlyReport Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Lead notification preferences
  leadNotifications    Boolean  @default(false)
  notifyManagers       String[] @default([]) // Empty = all managers, or specific manager names
  notifyStartTime      String?  // e.g., "09:00" (GMT+5), null = non-stop
  notifyEndTime        String?  // e.g., "18:00" (GMT+5), null = non-stop

  // Response tracking
  responses LeadNotificationResponse[]
}

// Track lead notifications sent to users
model LeadNotification {
  id          String   @id @default(cuid())
  leadId      Int      // amoCRM lead ID
  leadName    String
  phone       String?
  source      String?  // Where lead came from
  manager     String   // Assigned manager name
  pipeline    String   // Sotuv/Intensiv
  pipelineId  Int      // amoCRM pipeline ID
  eventType   String   @default("new") // "new" or "reassigned"
  sentAt      DateTime @default(now())
  isQueued    Boolean  @default(false) // true if queued for morning delivery

  responses   LeadNotificationResponse[]

  @@index([leadId])
  @@index([sentAt])
  @@index([manager])
  @@index([leadId, eventType, sentAt]) // For duplicate detection
}

// Track user responses to lead notifications (button clicks)
model LeadNotificationResponse {
  id              String   @id @default(cuid())
  notificationId  String
  userId          Int
  visitorId       String?  // chatId as string for URL-based tracking
  clickedAt       DateTime @default(now())
  responseTimeMs  Int      // Time from notification sent to button click

  notification    LeadNotification @relation(fields: [notificationId], references: [id])
  user            TelegramUser     @relation(fields: [userId], references: [id])

  @@unique([notificationId, userId]) // One response per user per notification
  @@unique([notificationId, visitorId]) // For URL-based tracking
  @@index([userId])
  @@index([clickedAt])
}

// Queue for after-hours notifications
model NotificationQueue {
  id              String   @id @default(cuid())
  userId          Int      // TelegramUser id to send to
  notificationId  String?  // Reference to LeadNotification record (created upfront for dedupe)
  leadId          Int      // amoCRM lead ID
  leadName        String
  phone           String?
  source          String?
  manager         String   // For new leads: the manager. For reassigned: newManager
  oldManager      String?  // For reassigned leads only
  pipeline        String
  pipelineId      Int
  eventType       String   @default("new") // "new" or "reassigned"
  createdAt       DateTime @default(now())
  scheduledFor    DateTime // When to send (9:05 AM GMT+5)
  sent            Boolean  @default(false)

  @@index([scheduledFor])
  @@index([sent])
  @@index([notificationId])
}

model CallsCache {
  id        Int      @id @default(autoincrement())
  period    String   @unique // e.g., "all" or "90days"
  data      String   // JSON-encoded calls data
  updatedAt DateTime @updatedAt
}

model OnlinePBXCall {
  id        String   @id @default(cuid())
  callId    String   @unique // Original call ID from OnlinePBX
  direction String   // "in" or "out"
  date      DateTime // When the call occurred
  duration  Int      // Duration in seconds
  phone     String   // Phone number
  user      String   // Manager/user name
  source    String   @default("webhook") // "webhook" or "api"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([user])
  @@index([createdAt])
}

model GoogleSheetCall {
  id              String   @id @default(cuid())
  callType        String   // "Пропущенный" / "Входящий" / "Исходящий" (Missed/Incoming/Outgoing)
  direction       String   // "missed" / "in" / "out"
  caller          String   // Caller ID/extension
  receiver        String   // Call receiver
  insideNumber    String?  // Inside number/gateway
  date            DateTime // When the call occurred
  duration        Int      // Call length in seconds
  successDuration Int      // Successful call length in seconds
  source          String   @default("sheet") // Source identifier
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date])
  @@index([caller])
  @@index([receiver])
  @@index([createdAt])
}

model UtelCall {
  id        String   @id @default(cuid())
  callId    String   @unique // Original call ID from Utel
  direction String   // "in" or "out"
  date      DateTime // When the call occurred
  duration  Int      // Duration in seconds (conversation time)
  phone     String   // Phone number (external for incoming, dst for outgoing)
  extension String   // Extension of the manager
  manager   String   // Manager name
  source    String   @default("webhook") // "webhook" or "api"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([manager])
  @@index([extension])
  @@index([createdAt])
}
